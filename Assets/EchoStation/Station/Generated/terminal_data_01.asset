  m_Script: {fileID: 11500000, guid: 1e1a0b2b52c70ed43aaa215961bb78e5, type: 3}
  m_Name: terminal_data_01
  m_EditorClassIdentifier: EchoStation.World.Runtime::EchoStation.World.ClueDefinition
  uniqueId: terminal_data_01
  title: "\u5C0F\u5C4B\u7EC8\u7AEF\u4EA4\u63A5\u6570\u636E"
  fullText: "\u7EF4\u62A4\u7EC8\u7AEF\u4EA4\u63A5\uFF1A\u5730\u4E0B\u901A\u8DEF\u6388\u6743\u5DF2\u6062\u590D\uFF0C\u5F00\u95E8\u64CD\u4F5C\u4ECD\u9700\u73B0\u573A\u4EBA\u5458\u786E\u8BA4\u3002A\u533A\u7684\u6392\u98CE\u652F\u8DEF\u4E0E\u5B9E\u9A8C\u4F9B\u7535\u4E0D\u662F\u540C\u4E00\u56DE\u8DEF\uFF0C\u8FD4\u7AD9\u68C0\u67E5\u65F6\u5E94\u5148\u6062\u590D\u5FC5\u8981\u901A\u98CE\uFF0C\u518D\u5224\u65AD\u5176\u4F59\u8BBE\u5907\u72B6\u6001\u3002\u50A8\u85CF\u5BA4\u5B9A\u4F4D\u6807\u8BB0\u6307\u5411\u5730\u4E0B\u6821\u51C6\u67B6\uFF0C\u4E0D\u662F\u95E8\u9501\u5F00\u5173\u3002\u901A\u98CE\u901A\u9053\u53E6\u6709\u7EF4\u62A4\u7EC8\u7AEF\uFF0C\u5B83\u9700\u8981\u5F53\u524D\u6821\u51C6\u8BB0\u5F55\uFF0C\u4E0D\u80FD\u91CD\u590D\u4F7F\u7528\u5730\u9762\u670D\u52A1\u7801\u3002\u539F\u59CB\u4E8B\u6545\u65E5\u5FD7\u5206\u6563\u5728\u5B9E\u9A8C\u5BA4\u3001\u901A\u9053\u548C\u6838\u5FC3\u63A7\u5236\u5BA4\uFF1B\u53EA\u6709\u5BF9\u7167\u6765\u6E90\u548C\u65F6\u95F4\uFF0C\u624D\u80FD\u533A\u5206\u6D4B\u8BD5\u3001\u62A5\u8B66\u3001\u4EBA\u5DE5\u9694\u79BB\u4E0E\u4EBA\u5458\u64A4\u79BB\u3002"
  summary: "\u5730\u4E0B\u901A\u8DEF\u5DF2\u6388\u6743\uFF1B\u5B9E\u9A8C\u5BA4\u3001\u901A\u9053\u548C\u6838\u5FC3\u5206\u522B\u4FDD\u5B58\u53EF\u4E92\u8BC1\u7684\u4E8B\u6545\u8D44\u6599\u3002"
  kind: 1
