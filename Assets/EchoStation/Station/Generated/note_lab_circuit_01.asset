  m_Name: note_lab_circuit_01
  m_EditorClassIdentifier: EchoStation.World.Runtime::EchoStation.World.ClueDefinition
  uniqueId: note_lab_circuit_01
  title: "A\u533A\u901A\u98CE\u56DE\u8DEF\u8BF4\u660E"
  fullText: "A\u533A\u4F9B\u7535\u8BF4\u660E\uFF1A\u590D\u67E5\u901A\u98CE\u53EA\u9700\u8981\u72EC\u7ACB\u6392\u98CE\u652F\u8DEF\u3002\u6B63\u786E\u72B6\u6001\u4E3A\u6392\u98CE\u5F00\u542F\u3001\u5185\u5FAA\u73AF\u5173\u95ED\u3001\u5B9E\u9A8C\u652F\u8DEF\u5173\u95ED\uFF0C\u5B8C\u6210\u68C0\u67E5\u540E\u7531\u73B0\u573A\u4EBA\u5458\u6309\u4E0B\u786E\u8BA4\u9001\u7535\u3002\u5185\u5FAA\u73AF\u91CD\u65B0\u63A5\u5165\u4F1A\u628A\u6D4B\u8BD5\u533A\u57DF\u7684\u6C34\u6C7D\u548C\u6B8B\u4F59\u96FE\u6C14\u5E26\u56DE\u901A\u9053\uFF0C\u5B9E\u9A8C\u652F\u8DEF\u4E5F\u4E0D\u5E94\u968F\u901A\u98CE\u4E00\u8D77\u6062\u590D\u3002\u9519\u8BEF\u7EC4\u5408\u4E0D\u4F1A\u6267\u884C\u9001\u7535\uFF0C\u8BF7\u6838\u5BF9\u6807\u7B7E\u540E\u91CD\u8BD5\u3002\u901A\u98CE\u6062\u590D\u540E\uFF0C\u5165\u53E3\u9644\u8FD1\u7684\u5C40\u90E8\u96FE\u6C14\u4F1A\u9010\u6E10\u6D88\u9000\uFF1B\u8FD9\u5E76\u4E0D\u4EE3\u8868\u5B9E\u9A8C\u8BBE\u5907\u53EF\u4EE5\u91CD\u65B0\u8FD0\u884C\u3002Echo\u7684\u626B\u63CF\u7ED3\u679C\u53EA\u662F\u4FE1\u606F\uFF0C\u4E0D\u80FD\u4EE3\u66FF\u56DE\u8DEF\u786E\u8BA4\u3002"
  summary: "\u901A\u98CE\u8981\u6C42\u6392\u98CE\u5F00\u542F\u3001\u5185\u5FAA\u73AF\u5173\u95ED\u3001\u5B9E\u9A8C\u652F\u8DEF\u5173\u95ED\uFF0C\u518D\u7531\u73A9\u5BB6\u786E\u8BA4\u9001\u7535\u3002"
  kind: 0
