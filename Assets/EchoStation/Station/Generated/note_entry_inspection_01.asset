  m_Name: note_entry_inspection_01
  m_EditorClassIdentifier: EchoStation.World.Runtime::EchoStation.World.ClueDefinition
  uniqueId: note_entry_inspection_01
  title: "\u5165\u53E3\u5DE1\u68C0\u8BB0\u5F55"
  fullText: "\u5165\u53E3\u5DE1\u68C0\u7559\u6863\uFF1A02:13\uFF0C\u5730\u4E0BA\u533A\u9996\u5148\u51FA\u73B0\u6392\u98CE\u5F02\u5E38\u62A5\u8B66\u3002\u5C71\u8C37\u6C14\u8C61\u8BBE\u5907\u4ECD\u5728\u8FDE\u7EED\u91C7\u6837\uFF0C\u5165\u53E3\u7167\u660E\u4E0E\u901A\u4FE1\u6307\u793A\u5747\u6B63\u5E38\u3002\u503C\u73ED\u5458\u4ECE\u5C0F\u5C4B\u8BF7\u6C42\u6838\u5BF9\u5B9E\u9A8C\u5BA4\u56DE\u8DEF\uFF0C\u6CA1\u6709\u7ACB\u5373\u5207\u65AD\u5168\u7AD9\u7535\u6E90\u300202:16\u4E4B\u540E\uFF0C\u5165\u53E3\u624D\u6536\u5230\u4EBA\u5DE5\u9694\u79BB\u5B9E\u9A8C\u652F\u8DEF\u7684\u901A\u77E5\u3002\u8BF7\u4FDD\u7559\u8FD9\u4EFD\u672C\u5730\u65F6\u95F4\u8BB0\u5F55\uFF0C\u8BBE\u5907\u4E0A\u7684\u65AD\u7535\u65F6\u95F4\u4E0D\u80FD\u5355\u72EC\u7528\u6765\u5224\u65AD\u4E8B\u6545\u8D77\u70B9\u3002\u4E0B\u4E00\u73ED\u590D\u67E5\u4EBA\u5458\u5E94\u5C06\u6B64\u8BB0\u5F55\u4E0E\u64A4\u79BB\u901A\u77E5\u5BF9\u7167\uFF0C\u4E0D\u8981\u628A\u5148\u540E\u76F8\u9694\u7684\u4E24\u6B21\u4E8B\u4EF6\u5408\u5E76\u4E3A\u4E00\u6B21\u6545\u969C\u3002"
  summary: "\u5165\u53E3\u8BB0\u5F55\u663E\u793A02:13\u5148\u62A5\u8B66\uFF0C02:16\u540E\u624D\u6536\u5230\u4EBA\u5DE5\u9694\u79BB\u5B9E\u9A8C\u652F\u8DEF\u901A\u77E5\u3002"
  kind: 0
