  m_Script: {fileID: 11500000, guid: 1e1a0b2b52c70ed43aaa215961bb78e5, type: 3}
  m_Name: note_roster_01
  m_EditorClassIdentifier: EchoStation.World.Runtime::EchoStation.World.ClueDefinition
  uniqueId: note_roster_01
  title: "\u503C\u73ED\u4EA4\u63A5\u5907\u5FD8"
  fullText: "\u503C\u73ED\u4EA4\u63A5\u5907\u5FD8\uFF1A\u6211\u4EEC\u64A4\u79BB\u65F6\u4FDD\u7559\u4E86\u57FA\u7840\u76D1\u6D4B\uFF0C\u6CA1\u6709\u4FDD\u7559\u5B9E\u9A8C\u8FD0\u884C\u6761\u4EF6\u3002\u5730\u4E0B\u8BBE\u5907\u7684\u6807\u7B7E\u53EF\u80FD\u76F8\u4F3C\uFF0C\u590D\u67E5\u65F6\u8BF7\u9010\u9879\u786E\u8BA4\u6392\u98CE\u3001\u5185\u5FAA\u73AF\u548C\u5B9E\u9A8C\u652F\u8DEF\uFF0C\u4E0D\u80FD\u53EA\u51ED\u6307\u793A\u706F\u4EAE\u706D\u5224\u65AD\u7528\u9014\u3002\u5B8C\u6574\u56DE\u8DEF\u8BF4\u660E\u653E\u5728A\u533A\u4F9B\u7535\u9762\u677F\u65C1\uFF0C\u4EFB\u4F55\u9001\u7535\u90FD\u5E94\u4EE5\u90A3\u4EFD\u8BF4\u660E\u4E3A\u51C6\u3002Echo\u53EF\u4EE5\u8BC6\u522B\u5F02\u5E38\u8BBE\u5907\u5E76\u63D0\u9192\u4FDD\u6301\u8DDD\u79BB\uFF0C\u4F46\u6CA1\u6709\u4EBA\u5DE5\u786E\u8BA4\u6743\u9650\u3002\u82E5\u626B\u63CF\u8BB0\u5F55\u4E0E\u7EB8\u9762\u6587\u6863\u51FA\u73B0\u4E0D\u540C\u8868\u8FF0\uFF0C\u8BF7\u628A\u4E24\u8005\u8BB0\u5165\u65E5\u5FD7\uFF0C\u4FDD\u7559\u539F\u59CB\u6765\u6E90\uFF0C\u518D\u5230\u6838\u5FC3\u6838\u5BF9\u4F20\u611F\u5668\u65F6\u5E8F\u3002"
  summary: "\u4EA4\u63A5\u8981\u6C42\u5728A\u533A\u67E5\u770B\u5B8C\u6574\u56DE\u8DEF\u8BF4\u660E\uFF0C\u533A\u5206\u901A\u98CE\u4E0E\u5B9E\u9A8C\u4F9B\u7535\uFF0C\u4E0D\u51ED\u6307\u793A\u706F\u731C\u7528\u9014\u3002"
  kind: 0
