  m_Script: {fileID: 11500000, guid: 1e1a0b2b52c70ed43aaa215961bb78e5, type: 3}
  m_Name: data_lab_maintenance_01
  m_EditorClassIdentifier: EchoStation.World.Runtime::EchoStation.World.ClueDefinition
  uniqueId: data_lab_maintenance_01
  title: "A\u533A\u7EF4\u62A4\u6307\u4EE4\u8BB0\u5F55"
  fullText: "\u7EF4\u62A4\u6307\u4EE4\u8BB0\u5F55\uFF1A\u505C\u7AD9\u524D\u7684\u6D4B\u8BD5\u4F7F\u7528\u4E86\u5C1A\u672A\u590D\u6838\u7684\u6392\u98CE\u4F20\u611F\u5668\u6821\u51C6\u503C\u3002\u6307\u4EE4\u628A\u5F02\u5E38\u8BFB\u6570\u89E3\u91CA\u4E3A\u652F\u8DEF\u672A\u63A5\u901A\uFF0C\u968F\u540E\u5C06\u5B9E\u9A8C\u533A\u9519\u8BEF\u63A5\u5165\u5185\u5FAA\u73AF\u3002\u8BB0\u5F55\u4E2D\u80FD\u770B\u5230\u6D4B\u8BD5\u8BF7\u6C42\u4E0E\u56DE\u8DEF\u5207\u6362\u5148\u4E8E\u62A5\u8B66\uFF0C\u4E0D\u80FD\u636E\u6B64\u63A8\u65AD\u62A5\u8B66\u662F\u4EBA\u5DE5\u9694\u79BB\u5F15\u8D77\u7684\u3002\u8BF7\u5C06\u672C\u8BB0\u5F55\u4E0E\u901A\u9053\u7EF4\u62A4\u56DE\u6267\u3001\u6838\u5FC3\u4F20\u611F\u5668\u65F6\u5E8F\u5BF9\u7167\uFF0C\u533A\u5206\u6307\u4EE4\u53D1\u51FA\u4E0E\u5B9E\u9645\u53CD\u9988\u3002\u4F4E\u529F\u8017\u751F\u6001\u76D1\u6D4B\u5728\u72EC\u7ACB\u652F\u8DEF\u4E0A\uFF0C\u539F\u59CB\u6307\u4EE4\u6CA1\u6709\u8981\u6C42\u505C\u7528\u5B83\uFF1B\u80FD\u5426\u4FDD\u7559\u8FD0\u884C\u4ECD\u987B\u5728\u6838\u5FC3\u786E\u8BA4\u9694\u79BB\u6761\u4EF6\u3002"
  summary: "\u672A\u590D\u6838\u7684\u6392\u98CE\u6821\u51C6\u503C\u5BFC\u81F4\u9519\u8BEF\u63A5\u5165\u5185\u5FAA\u73AF\uFF1B\u5E94\u4E0E\u901A\u9053\u56DE\u6267\u548C\u6838\u5FC3\u65F6\u5E8F\u4E92\u8BC1\u3002"
  kind: 1
