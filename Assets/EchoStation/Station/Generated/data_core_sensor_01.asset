  m_Script: {fileID: 11500000, guid: 1e1a0b2b52c70ed43aaa215961bb78e5, type: 3}
  m_Name: data_core_sensor_01
  m_EditorClassIdentifier: EchoStation.World.Runtime::EchoStation.World.ClueDefinition
  uniqueId: data_core_sensor_01
  title: "\u6838\u5FC3\u4F20\u611F\u5668\u65F6\u5E8F"
  fullText: "\u6838\u5FC3\u4F20\u611F\u5668\u65F6\u5E8F\uFF1A\u5B9E\u9A8C\u652F\u8DEF\u6D4B\u8BD5\u8BF7\u6C42\u4E4B\u540E\uFF0C\u6392\u98CE\u8BFB\u6570\u9996\u5148\u504F\u79BB\u590D\u6838\u8303\u56F4\uFF0C\u5185\u5FAA\u73AF\u5207\u6362\u4F7F\u5F02\u5E38\u7A7A\u6C14\u56DE\u6D41\uFF0C\u968F\u540E\u624D\u51FA\u73B0\u6392\u98CE\u62A5\u8B66\u548C\u4EBA\u5DE5\u9694\u79BB\u3002\u8BE5\u65F6\u5E8F\u4E0EA\u533A\u7EF4\u62A4\u6307\u4EE4\u3001\u901A\u9053\u8BBE\u5907\u56DE\u6267\u53EF\u4EE5\u76F8\u4E92\u6838\u5BF9\uFF0C\u652F\u6301\u6821\u51C6\u504F\u5DEE\u7ECF\u9519\u8BEF\u7EF4\u62A4\u5224\u65AD\u5F15\u53D1\u56DE\u6D41\u7684\u7ED3\u8BBA\u3002\u751F\u6001\u76D1\u6D4B\u652F\u8DEF\u5728\u6574\u4E2A\u8FC7\u7A0B\u4E2D\u4FDD\u6301\u72EC\u7ACB\uFF0C\u9694\u79BB\u5B9E\u9A8C\u4F9B\u7535\u540E\u4ECD\u53EF\u4F4E\u529F\u8017\u91C7\u6837\u3002\u662F\u5426\u4FDD\u7559\u76D1\u6D4B\u7531\u8FD4\u7AD9\u4EBA\u5458\u786E\u8BA4\u3002\u8BF7\u5728\u65E5\u5FD7\u4E2D\u5B8C\u6210\u4E09\u4EFD\u8D44\u6599\u7684\u6838\u5BF9\uFF0C\u4E0D\u8981\u4EC5\u51ED\u4E00\u6761\u65F6\u95F4\u7EBF\u66FF\u4EE3\u5B8C\u6574\u8BC1\u636E\u94FE\u3002"
  summary: "\u6838\u5FC3\u65F6\u5E8F\u652F\u6301\u6821\u51C6\u504F\u5DEE\u4E0E\u9519\u8BEF\u56DE\u8DEF\u5224\u65AD\u9020\u6210\u56DE\u6D41\uFF0C\u5E76\u8BC1\u660E\u4F4E\u529F\u8017\u76D1\u6D4B\u53EF\u72EC\u7ACB\u4FDD\u7559\u3002"
  kind: 1
