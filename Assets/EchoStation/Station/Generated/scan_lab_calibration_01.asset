  m_Name: scan_lab_calibration_01
  m_EditorClassIdentifier: EchoStation.World.Runtime::EchoStation.World.ClueDefinition
  uniqueId: scan_lab_calibration_01
  title: "A\u533A\u6821\u51C6\u67B6\u626B\u63CF"
  fullText: "Echo\u626B\u63CF\u7ED3\u679C\uFF1A\u6821\u51C6\u67B6\u7684\u9690\u5C42\u6807\u8BB0\u6CE8\u660E\uFF0C\u914D\u5BF9\u4F4D\u7F6E\u4E3A\u5C0F\u5C4B\u50A8\u85CF\u5BA4\u3002\u4E24\u5904\u8BB0\u5F55\u90FD\u53D6\u5F97\u540E\u624D\u80FD\u590D\u6838\u5B9A\u4F4D\u5E8F\u5217\u3002\u901A\u9053\u7EF4\u62A4\u7801\u4E3A0428\uFF0C\u4F9B\u4EBA\u5DE5\u5728\u901A\u98CE\u901A\u9053\u7EC8\u7AEF\u8F93\u5165\u3002\u901A\u9053\u6821\u51C6\u51ED\u8BC1\u9700\u8981\u4E24\u5904\u771F\u5B9E\u626B\u63CF\u8BB0\u5F55\u5171\u540C\u6784\u6210\uFF0C\u5355\u72EC\u6284\u5199\u6570\u5B57\u4E0D\u80FD\u4EE3\u66FF\u9A8C\u8BC1\u94FE\u3002\u8BE5\u6807\u8BB0\u53EA\u8BC1\u660E\u7EF4\u62A4\u5E8F\u5217\u5BF9\u5E94\uFF0C\u4E0D\u8868\u793A\u4EFB\u4F55\u5371\u9669\u652F\u8DEF\u5DF2\u7ECF\u5B89\u5168\u3002\u626B\u63CF\u4E0D\u4F1A\u6253\u5F00\u95E8\u3001\u4FEE\u6539\u56DE\u8DEF\u6216\u66FF\u4F60\u63D0\u4EA4\u7EC8\u7AEF\u6307\u4EE4\u3002\u8BF7\u5728\u901A\u98CE\u6062\u590D\u3001\u901A\u8DEF\u53EF\u8FBE\u540E\u524D\u5F80\u7EF4\u62A4\u7EC8\u7AEF\uFF0C\u6838\u5BF9\u672C\u8BB0\u5F55\uFF0C\u518D\u7531\u4F60\u8F93\u5165\u7EF4\u62A4\u7801\u5B8C\u6210\u8BBF\u95EE\u786E\u8BA4\u3002"
  summary: "A\u533A\u626B\u63CF\u53D6\u5F97\u901A\u9053\u7EF4\u62A4\u7801\uFF1B\u51ED\u8BC1\u9700\u8981\u5C0F\u5C4B\u4E0EA\u533A\u4E24\u5904\u771F\u5B9E\u626B\u63CF\u8BB0\u5F55\u5171\u540C\u9A8C\u8BC1\u3002"
  kind: 2
