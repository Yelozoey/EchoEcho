  m_Script: {fileID: 11500000, guid: 1e1a0b2b52c70ed43aaa215961bb78e5, type: 3}
  m_Name: note_lab_sensor_01
  m_EditorClassIdentifier: EchoStation.World.Runtime::EchoStation.World.ClueDefinition
  uniqueId: note_lab_sensor_01
  title: "\u4F20\u611F\u5668\u590D\u6838\u4FBF\u7B7E"
  fullText: "\u4F20\u611F\u5668\u590D\u6838\u4FBF\u7B7E\uFF1A\u6392\u98CE\u8BFB\u6570\u7684\u6821\u51C6\u504F\u5DEE\u4E0D\u4F1A\u81EA\u52A8\u6539\u53D8\u56DE\u8DEF\uFF0C\u771F\u6B63\u7684\u652F\u8DEF\u5207\u6362\u6765\u81EA\u540E\u7EED\u7EF4\u62A4\u6307\u4EE4\u3002\u590D\u67E5\u65F6\u8981\u628A\u6D4B\u91CF\u3001\u5224\u65AD\u548C\u64CD\u4F5C\u5206\u522B\u8BB0\u5F55\uFF0C\u907F\u514D\u628A\u5B83\u4EEC\u5408\u6210\u4E00\u4E2A\u539F\u56E0\u3002\u751F\u6001\u76D1\u6D4B\u4F7F\u7528\u72EC\u7ACB\u91C7\u6837\u4E0E\u4F4E\u529F\u8017\u4F9B\u7535\uFF0C\u4E0D\u5E94\u4E0E\u5B9E\u9A8C\u63A7\u5236\u4E00\u540C\u91CD\u542F\u3002\u5C40\u90E8\u96FE\u6C14\u4E3B\u8981\u662F\u505C\u7AD9\u540E\u7684\u6C34\u6C7D\u548C\u6B8B\u4F59\u6D4B\u8BD5\u4ECB\u8D28\uFF0C\u6062\u590D\u6392\u98CE\u53EF\u6539\u5584\u901A\u884C\uFF0C\u4F46\u4E0D\u80FD\u636E\u6B64\u5224\u65AD\u5168\u90E8\u8BBE\u5907\u5DF2\u4FEE\u590D\u3002\u9700\u8981\u5B8C\u6574\u4E8B\u6545\u7ED3\u8BBA\u65F6\uFF0C\u8BF7\u5230\u901A\u9053\u4E0E\u6838\u5FC3\u8865\u9F50\u5B9E\u9645\u53CD\u9988\u8BB0\u5F55\u3002"
  summary: "\u5E94\u533A\u5206\u4F20\u611F\u5668\u6D4B\u91CF\u3001\u7EF4\u62A4\u5224\u65AD\u548C\u56DE\u8DEF\u64CD\u4F5C\uFF1B\u5C40\u90E8\u901A\u98CE\u6062\u590D\u4E0D\u7B49\u4E8E\u5B9E\u9A8C\u8BBE\u5907\u4FEE\u590D\u3002"
  kind: 0
