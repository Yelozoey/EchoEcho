  m_Script: {fileID: 11500000, guid: 1e1a0b2b52c70ed43aaa215961bb78e5, type: 3}
  m_Name: note_maintenance_01
  m_EditorClassIdentifier: EchoStation.World.Runtime::EchoStation.World.ClueDefinition
  uniqueId: note_maintenance_01
  title: "\u5C0F\u5C4B\u7EF4\u62A4\u8BB0\u5F55"
  fullText: "\u5730\u9762\u7EF4\u62A4\u5907\u5FD8\uFF1A\u8FD4\u7AD9\u590D\u67E5\u4EBA\u5458\u53EF\u4F7F\u7528\u670D\u52A1\u78017316\u767B\u5F55\u5C0F\u5C4B\u7EF4\u62A4\u7EC8\u7AEF\uFF0C\u8BFB\u53D6\u5730\u4E0B\u901A\u8DEF\u6388\u6743\u548C\u505C\u7AD9\u540E\u7684\u5DE5\u4F5C\u4EA4\u63A5\u3002\u8FD9\u4E2A\u670D\u52A1\u7801\u53EA\u7528\u4E8E\u5730\u9762\u7EC8\u7AEF\uFF0C\u4E0D\u80FD\u4EE3\u66FF\u901A\u98CE\u901A\u9053\u7684\u6821\u51C6\u51ED\u8BC1\u3002\u50A8\u85CF\u5BA4\u4E1C\u5899\u7559\u6709\u65E7\u6821\u51C6\u5B9A\u4F4D\u6807\u8BB0\uFF0C\u666E\u901A\u7167\u660E\u4E0B\u4E0D\u6613\u8FA8\u8BA4\uFF0C\u53EF\u8BA9Echo\u9760\u8FD1\u626B\u63CF\u3002\u7EC8\u7AEF\u8BFB\u53D6\u540E\uFF0C\u5730\u4E0B\u5165\u53E3\u4ECD\u9700\u7531\u590D\u67E5\u4EBA\u5458\u4EB2\u81EA\u786E\u8BA4\u5F00\u542F\u3002\u8BF7\u52FF\u8BA9\u8F85\u52A9\u673A\u5668\u4EBA\u4EE3\u8F93\u5BC6\u7801\u6216\u5207\u6362\u8BBE\u5907\uFF1B\u5B83\u53EA\u8D1F\u8D23\u68C0\u67E5\u3001\u8BB0\u5F55\u4E0E\u63D0\u4F9B\u7EBF\u7D22\u3002\u65E7\u503C\u73ED\u8BB0\u5F55\u4E5F\u5E94\u4E00\u5E76\u5E26\u8D70\u6838\u5BF9\u3002"
  summary: "\u5C0F\u5C4B\u7EF4\u62A4\u8BB0\u5F55\u5199\u6709\u5730\u9762\u7EC8\u7AEF\u670D\u52A1\u7801\uFF0C\u5E76\u63D0\u793A\u50A8\u85CF\u5BA4\u4E1C\u5899\u5B58\u5728\u53EF\u626B\u63CF\u5B9A\u4F4D\u6807\u8BB0\u3002"
  kind: 0
