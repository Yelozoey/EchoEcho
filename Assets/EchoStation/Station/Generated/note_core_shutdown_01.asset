  m_Script: {fileID: 11500000, guid: 1e1a0b2b52c70ed43aaa215961bb78e5, type: 3}
  m_Name: note_core_shutdown_01
  m_EditorClassIdentifier: EchoStation.World.Runtime::EchoStation.World.ClueDefinition
  uniqueId: note_core_shutdown_01
  title: "\u6838\u5FC3\u5904\u7F6E\u8BF4\u660E"
  fullText: "\u6838\u5FC3\u5904\u7F6E\u8BF4\u660E\uFF1A\u73B0\u573A\u4EBA\u5458\u53EF\u9009\u62E9\u5C01\u5B58\u64A4\u79BB\uFF0C\u4FDD\u6301\u5371\u9669\u5B9E\u9A8C\u652F\u8DEF\u505C\u6B62\u5E76\u5E26\u8D70\u73B0\u6709\u8BB0\u5F55\uFF1B\u82E5\u5DF2\u5B8C\u6210\u4E8B\u6545\u8D44\u6599\u4E92\u8BC1\uFF0C\u53EF\u9009\u62E9\u4EC5\u4FDD\u7559\u72EC\u7ACB\u4F4E\u529F\u8017\u76D1\u6D4B\uFF0C\u7531Echo\u6309\u660E\u786E\u7EA6\u5B9A\u7559\u7AD9\u503C\u5B88\u3002\u5B8C\u6574\u5F52\u6863\u8FD8\u9700\u8981\u5165\u53E3\u65F6\u95F4\u7EBF\u4E0E\u6838\u5FC3\u4E8B\u6545\u8BC1\u636E\u5747\u6838\u5BF9\u5B8C\u6210\uFF0C\u4E4B\u540E\u53EF\u5C06\u5168\u5957\u8BB0\u5F55\u5199\u5165\u672C\u5730\u968F\u8EAB\u5B58\u50A8\u5E76\u4E0EEcho\u64A4\u79BB\u3002\u8FD9\u4E9B\u9009\u62E9\u90FD\u5FC5\u987B\u7531\u4F60\u5728\u6838\u5FC3\u7EC8\u7AEF\u786E\u8BA4\uFF0C\u673A\u5668\u4EBA\u4E0D\u4F1A\u4EE3\u9009\u3002\u8BC1\u636E\u4E0D\u8DB3\u65F6\u53EF\u4EE5\u53D6\u6D88\u5E76\u6CBF\u539F\u8DEF\u8865\u67E5\uFF0C\u6700\u7EC8\u786E\u8BA4\u4E5F\u4E0D\u4F1A\u81EA\u52A8\u8986\u76D6\u4E4B\u524D\u7684\u624B\u52A8\u5B58\u6863\u3002"
  summary: "\u6838\u5FC3\u6709\u5C01\u5B58\u64A4\u79BB\u3001\u4FDD\u7559\u76D1\u6D4B\u3001\u5B8C\u6574\u5F52\u6863\u4E09\u79CD\u4EBA\u5DE5\u9009\u62E9\uFF0C\u6761\u4EF6\u4E0D\u8DB3\u53EF\u8FD4\u56DE\u8865\u67E5\u3002"
  kind: 0
