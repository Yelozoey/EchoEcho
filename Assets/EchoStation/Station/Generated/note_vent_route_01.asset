  m_Script: {fileID: 11500000, guid: 1e1a0b2b52c70ed43aaa215961bb78e5, type: 3}
  m_Name: note_vent_route_01
  m_EditorClassIdentifier: EchoStation.World.Runtime::EchoStation.World.ClueDefinition
  uniqueId: note_vent_route_01
  title: "\u901A\u98CE\u901A\u9053\u7EF4\u62A4\u63D0\u793A"
  fullText: "\u901A\u9053\u7EF4\u62A4\u63D0\u793A\uFF1A\u5165\u53E3\u96FE\u6C14\u6D88\u9000\u540E\u65B9\u53EF\u7EE7\u7EED\u590D\u67E5\uFF0C\u4E0D\u8981\u4ECE\u505C\u7AD9\u8BBE\u5907\u7684\u7F1D\u9699\u8D8A\u8FC7\u9694\u79BB\u8FB9\u754C\u3002\u8FD9\u91CC\u7684\u7EC8\u7AEF\u63A5\u6536A\u533A\u6821\u51C6\u7EF4\u62A4\u7801\uFF0C\u540C\u65F6\u68C0\u67E5\u50A8\u85CF\u5BA4\u548CA\u533A\u7684\u626B\u63CF\u51ED\u8BC1\u3002\u82E5\u53EA\u6709\u6570\u5B57\u800C\u9A8C\u8BC1\u94FE\u4E0D\u5B8C\u6574\uFF0C\u5E94\u8FD4\u56DE\u8865\u9F50\u626B\u63CF\uFF1B\u82E5\u4E24\u5904\u8BB0\u5F55\u9F50\u5168\uFF0C\u8BF7\u68C0\u67E5\u662F\u5426\u8F93\u5165\u4E86\u901A\u9053\u7EF4\u62A4\u7801\uFF0C\u800C\u4E0D\u662F\u5C0F\u5C4B\u670D\u52A1\u7801\u3002\u7EC8\u7AEF\u53EA\u5411\u73B0\u573A\u4EBA\u5458\u63D0\u4F9B\u8BBF\u95EE\u786E\u8BA4\uFF0CEcho\u53EF\u4EE5\u6574\u7406\u5DF2\u6709\u8BB0\u5F55\u4F46\u4E0D\u80FD\u66FF\u4F60\u63D0\u4EA4\u3002\u539F\u8DEF\u59CB\u7EC8\u4FDD\u7559\uFF0C\u53EF\u56DE\u770B\u9057\u6F0F\u7684\u8D44\u6599\uFF0C\u4E0D\u9700\u8981\u53CD\u590D\u5207\u6362\u5DF2\u7ECF\u786E\u8BA4\u7684\u901A\u98CE\u56DE\u8DEF\u3002"
  summary: "\u901A\u9053\u7EC8\u7AEF\u68C0\u67E5\u4E24\u5904\u626B\u63CF\u51ED\u8BC1\u53CA\u901A\u9053\u7EF4\u62A4\u7801\uFF1B\u53EF\u539F\u8DEF\u8FD4\u56DE\u8865\u9F50\u8BB0\u5F55\u3002"
  kind: 0
