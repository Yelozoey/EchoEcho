  m_Name: terminal_vent_data_01
  m_EditorClassIdentifier: EchoStation.World.Runtime::EchoStation.World.ClueDefinition
  uniqueId: terminal_vent_data_01
  title: "\u901A\u9053\u7EF4\u62A4\u56DE\u6267"
  fullText: "\u901A\u9053\u7EF4\u62A4\u56DE\u6267\uFF1A\u6821\u51C6\u8BB0\u5F55\u5DF2\u7531\u73B0\u573A\u4EBA\u5458\u786E\u8BA4\u3002\u505C\u7AD9\u65E5\u5FD7\u663E\u793A\u5B9E\u9A8C\u533A\u57DF\u5148\u63A5\u5165\u5185\u5FAA\u73AF\uFF0C\u968F\u540E\u76D1\u6D4B\u5230\u56DE\u6D41\u5E76\u89E6\u53D1\u6392\u98CE\u5F02\u5E38\u62A5\u8B66\uFF1B\u4EBA\u5DE5\u9694\u79BB\u64CD\u4F5C\u53D1\u751F\u5728\u5176\u540E\u3002\u8BE5\u56DE\u6267\u8BB0\u5F55\u5B9E\u9645\u8BBE\u5907\u53CD\u9988\uFF0C\u4E0EA\u533A\u7EF4\u62A4\u6307\u4EE4\u662F\u4E0D\u540C\u6765\u6E90\u3002\u6838\u5FC3\u63A7\u5236\u5BA4\u8FD8\u4FDD\u7559\u72EC\u7ACB\u4F20\u611F\u5668\u65F6\u5E8F\uFF0C\u53EF\u7528\u4E8E\u6700\u7EC8\u6838\u5BF9\u3002\u6838\u5FC3\u901A\u8DEF\u6388\u6743\u5DF2\u7ECF\u5F00\u653E\uFF0C\u95E8\u4ECD\u9700\u7531\u4F60\u73B0\u573A\u786E\u8BA4\u5F00\u542F\u3002\u8BF7\u4FDD\u7559\u6B64\u56DE\u6267\uFF0C\u4E0D\u8981\u628A\u901A\u98CE\u6682\u65F6\u6062\u590D\u89E3\u91CA\u4E3A\u5141\u8BB8\u6062\u590D\u5B9E\u9A8C\uFF1B\u4F4E\u529F\u8017\u76D1\u6D4B\u662F\u5426\u53EF\u4FDD\u7559\u8981\u6309\u6838\u5FC3\u8BF4\u660E\u5904\u7406\u3002"
  summary: "\u901A\u9053\u53CD\u9988\u8BC1\u5B9E\u5185\u5FAA\u73AF\u63A5\u5165\u4E0E\u56DE\u6D41\u5148\u4E8E\u62A5\u8B66\uFF0C\u4EBA\u5DE5\u9694\u79BB\u5728\u540E\uFF1B\u6838\u5FC3\u901A\u8DEF\u83B7\u6388\u6743\u3002"
  kind: 1
